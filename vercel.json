{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/advocacy-blueprint", "destination": "/oem-advocacy", "permanent": true },
    { "source": "/advocacy-blueprint.html", "destination": "/oem-advocacy", "permanent": true },
    { "source": "/services/collision-repair", "destination": "/services/collision-frame-repair", "permanent": true },
    { "source": "/services/custom-paint", "destination": "/services/paint-coating-detailing", "permanent": true },
    { "source": "/services/ceramic-coating", "destination": "/services/paint-coating-detailing", "permanent": true },
    { "source": "/services/detailing", "destination": "/services/paint-coating-detailing", "permanent": true },
    { "source": "/services/insurance-assistance", "destination": "/oem-advocacy", "permanent": true },
    { "source": "/services", "destination": "/services/collision-frame-repair", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
